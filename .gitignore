# ── Credentials — never commit these ─────────────────────────────────────────
# These live ONLY on the server, created from deploy/*.sample.php.
# Bare names also match at any depth, but the explicit paths document intent.
db.php
inc/db.php
sso_config.php
inc/sso_config.php
.env

# Any local copy of the hub's credentials. The hub's db.php was copied in
# during the original replication and renamed; a bare "db.php" rule does not
# match a renamed file, and that file carries live SiteGround, Spark and
# SendGrid secrets. Ignore the whole folder.
_to_delete/
*hub-reference*

# ── Data exports, never in the docroot or git ────────────────────────────────
# Subscriber emails exported from the hub. Keep it outside the project folder
# (Nova publishes everything here); the import reads it from /home/admin/.
hot_sheets_export.json

# Screenshots from earlier Claude sessions, not part of the site
Claude outputs/

# SMB placeholders for files deleted while another machine had them open
.smbdelete*

# Bulk-profile inputs for cron/import_profiles.php: agent contact details
# and bios. Data, not code; denied on the web by .htaccess and the vhost.
import/

# ── Uploaded files ───────────────────────────────────────────────────────────
receipts/
assets/uploads/

# ── Logs & system files ──────────────────────────────────────────────────────
*.log
.DS_Store
Thumbs.db

# ── Editors ──────────────────────────────────────────────────────────────────
.nova/
.idea/
.vscode/
*.swp

# NOTE: vendor/ is deliberately NOT ignored. There is no Composer on the
# server, so PHPMailer has to arrive with the repo. It is ~676K.
