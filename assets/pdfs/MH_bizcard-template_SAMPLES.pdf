   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Painterly lake scenery in Germany with mountains reflected in the teal water and a beautiful ray of morning sunlight illuminating some trees</rdf:li>
    </rdf:Alt>
